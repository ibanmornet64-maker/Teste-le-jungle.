# ─────────────────────────────────────────────────────────────
#  Le Jungle — variables d'environnement
#  Copier ce fichier en `.env.local` (jamais commité) et remplir.
# ─────────────────────────────────────────────────────────────

# URL publique définitive du site (SEO, sitemap, Open Graph).
# Ex. https://www.lejungle64.fr
NEXT_PUBLIC_SITE_URL=

# ── Réception des formulaires (contact, réservation, groupes) ──
# Option A — email via Resend (https://resend.com) : recommandé.
RESEND_API_KEY=
# Une ou plusieurs adresses séparées par des virgules.
CONTACT_TO_EMAIL=
# Expéditeur vérifié chez Resend, ex. "Site Le Jungle <site@lejungle64.fr>"
CONTACT_FROM_EMAIL=

# Option B — webhook (Make, Zapier, n8n, Google Apps Script…).
# Utilisée seulement si l'option A n'est pas configurée.
CONTACT_WEBHOOK_URL=

# Option C — développement uniquement : affiche la demande dans le terminal.
# Ignorée en production. Laisser vide sinon.
CONTACT_DELIVERY=

# Sans aucune option configurée, le formulaire affiche une erreur explicite
# (aucun envoi silencieux, aucune fausse confirmation).

# ── Espace d'administration ──
# /admin est visible en développement. En production, mettre `true`
# pour l'afficher temporairement (page non indexée, sans mot de passe :
# ne pas laisser activé sur le site public).
ADMIN_PREVIEW=
