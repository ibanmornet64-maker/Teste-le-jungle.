# ─────────────────────────────────────────────────────────────
#  Le Jungle — variables d'environnement (toutes facultatives)
#  En local : copier ce fichier en `.env.local` (jamais commité).
#  Sur Vercel : Project → Settings → Environment Variables.
#
#  Le site est un site vitrine 100 % statique : aucune clé d'API,
#  aucun serveur de formulaire, aucune base de données.
# ─────────────────────────────────────────────────────────────

# URL publique définitive du site (SEO, sitemap, Open Graph).
# Ex. https://www.lejungle64.fr
# Sur Vercel, si vide : l'adresse xxx.vercel.app est utilisée automatiquement.
NEXT_PUBLIC_SITE_URL=

# Mettre `true` pour empêcher Google d'indexer le site (ex. tant que les
# photos temporaires sont en place). Les prévisualisations Vercel ne sont
# jamais indexées, quelle que soit cette valeur.
SITE_NOINDEX=

# Flux Instagram (Behold.so, gratuit) : affiche automatiquement les 4 dernières
# publications de @lejungle64 dans la section « La jungle by night » de l'accueil.
# Ex. https://feeds.behold.so/AbCdEf123456 — vide : le bloc n'apparaît pas.
# Mode d'emploi complet : README, section 6 bis.
INSTAGRAM_FEED_URL=
